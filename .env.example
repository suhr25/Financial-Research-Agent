# === Mode ===
# When true (or when required API keys below are missing), the app runs with
# deterministic mock providers instead of live external services. Mock sources
# are always clearly labelled as such (source_tier=MOCK) and are never
# presented as real SEC/web/API data.
DEMO_MODE=true

# === LLM Provider ===
# One of: claude, openai, groq
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Groq: OpenAI-compatible API, free tier available at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
# Optional: paces LLM calls to stay under this tokens-per-minute budget
# instead of firing them as fast as possible and hitting 429s. Leave unset
# for a paid/high-limit account. Groq's free tier measured as low as 8000
# TPM depending on the underlying model - set comfortably below that.
LLM_TPM_LIMIT=

# === Web Search Provider ===
# One of: tavily, serpapi
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# === Financial Data Providers ===
# SEC EDGAR requires a descriptive User-Agent per SEC fair-access policy.
SEC_EDGAR_USER_AGENT="Financial Research Agent OJT Project contact@example.com"
ALPHAVANTAGE_API_KEY=

# === Storage ===
DATABASE_URL=sqlite:///./data/financial_research_agent.db

# === Agent loop limits ===
# MAX_FOLLOWUP_ITERATIONS: each extra iteration re-runs retrieval +
# extraction + verification, roughly doubling wall-clock time per
# iteration. On a rate-limited free LLM tier that dominates latency, so 0
# (skip follow-up research) is a reasonable setting there; raise it to 1-2
# when running against a provider with headroom.
MAX_FOLLOWUP_ITERATIONS=2
MAX_RESEARCH_QUERIES=12
MAX_SUBQUERIES_PER_PLAN=6

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
